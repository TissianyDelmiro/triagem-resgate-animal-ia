      "id": "b000040c-5027-4230-b1b7-053d3037dc86",
      "name": "OpenAI - Classificar Relato (Reserva)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        928,
        704
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let t = null;\ntry { t = $json.output[0].content[0].text; } catch (e) { t = null; }\nif (t && typeof t === 'object') { t = JSON.stringify(t); }\nreturn { json: { candidates: [{ content: { parts: [{ text: t || '' }] } }], fonte_ia: 'openai' } };"
      },
      "id": "84784c17-78ce-4744-9ae1-b0468bd21b92",
      "name": "Normalizar Resposta OpenAI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        608
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const origem = $('Montar Requisição').item.json;\nconst resp = $json;\nconst ordem = ['critica', 'alta', 'media', 'baixa'];\nlet r = null;\nlet revisao = false;\n\ntry {\n  const txt = resp.candidates[0].content.parts[0].text;\n  r = JSON.parse(txt.replace(/```json|```/g, '').trim());\n  if (!ordem.includes(r.urgencia)) throw new Error('urgencia invalida');\n} catch (e) {\n  // Falha ao interpretar a IA: na dúvida, urgência alta e revisão manual\n  revisao = true;\n  r = {\n    tipo_caso: 'outro',\n    urgencia: 'alta',\n    justificativa_urgencia: 'Falha ao interpretar a resposta da IA. Classificado como alta por segurança.',\n    especie: null,\n    quantidade_animais: null,\n    local: null,\n    resumo: (origem.descricao || '').slice(0, 200),\n    acao_sugerida: 'Revisar o relato manualmente.',\n    precisa_mais_info: false,\n    informacoes_faltantes: [],\n    confianca: 0\n  };\n}\n\nr.informacoes_faltantes = Array.isArray(r.informacoes_faltantes) ? r.informacoes_faltantes : [];\nr.precisa_mais_info = Boolean(r.precisa_mais_info);\n// Guarda-corpo: confiança baixa sobe um nível de urgência e pede revisão\nif (!revisao && typeof r.confianca === 'number' && r.confianca < 0.5 && r.urgencia !== 'critica') {\n  const i = ordem.indexOf(r.urgencia);\n  r.urgencia = ordem[i - 1];\n  r.justificativa_urgencia += ' (urgência elevada por baixa confiança)';\n  revisao = true;\n}\n\n// Guarda-corpo: sem local nenhum, pede mais informações em vez de chutar\nconst localFinal = r.local || origem.local || null;\nif (!localFinal && r.tipo_caso !== 'outro') {\n  r.precisa_mais_info = true;\n  if (!r.informacoes_faltantes.includes('local exato')) r.informacoes_faltantes.push('local exato');\n}\nr.modelo = $('Normalizar Resposta OpenAI').isExecuted ? 'OpenAI' : 'Gemini';\nreturn {\n  json: {\n    caso_id: 'CASO-' + Date.now(),\n    status: 'Novo',\n    revisao_manual: revisao,\n    nome: origem.nome,\n    email: origem.email,\n    data_envio: origem.data_envio,\n    descricao: origem.descricao,\n    especie_informada: origem.especie,\n    ...r,\n    local: localFinal,\n    informacoes_faltantes_texto: r.informacoes_faltantes.join(', '),\n    email_voluntario: origem.email_voluntario,\n    email_coordenacao: origem.email_coordenacao,\n    nome_ong: origem.nome_ong,\n    minutos_escalonamento: origem.minutos_escalonamento\n  }\n};"
      },
      "id": "daf7afd8-cf94-4f97-a324-de819ac631bb",
      "name": "Validar Resposta do Gemini",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
