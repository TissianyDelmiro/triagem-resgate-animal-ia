      "id": "504334bd-ecfe-49cb-874c-802145036621",
      "name": "Gemini - Classificar Relato",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1264,
        416
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const tentativa = $runIndex + 1;\nconst maxTentativas = 3;\nconst esgotou = tentativa >= maxTentativas;\nconst esperaSegundos = esgotou ? 0 : 5 * Math.pow(2, tentativa - 1);\nconst detalhe = ($json.error && $json.error.message) ? $json.error.message : JSON.stringify($json.error || {});\nreturn { json: { ...$('Montar Requisição').item.json, tentativa, espera_segundos: esperaSegundos, esgotou, erro_gemini: detalhe } };"
      },
